# ==========================================
# CineOps Guardian — Environment Configuration
# ==========================================

# Mode: "mock" (offline hermetic demo) or "real" (live cloud services)
DEMO_MODE=mock

# Server Configuration
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# Google Cloud Platform
GOOGLE_CLOUD_PROJECT=project-55fbcfd2-0ad6-4c99-a25
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=HIGH
BIGQUERY_DATASET=cineops_guardian
GCS_BUCKET=cineops-guardian-evidence

# Grafana Cloud & MCP Server Configuration
GRAFANA_URL=https://your-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_example_token
GRAFANA_MCP_URL=http://localhost:8000
GRAFANA_STACK_ID=123456
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_OTLP_USERNAME=123456
GRAFANA_OTLP_TOKEN=glc_example_token
